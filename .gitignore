# ============================================================
#  CodeKraftHub Internship 2026 — Root .gitignore
#  Applies to all projects in this monorepo
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
.env/
virtualenv/

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.*
!.env.example
*.env
secrets.json
credentials.json
service_account.json
*.pem
*.key
*.p12
*.pfx
token.json
auth.json

# --- Flask / Web ---
instance/
.webassets-cache
flask_session/

# --- Database files ---
*.db
*.sqlite
*.sqlite3
*.sql.backup

# --- Logs ---
*.log
logs/
log/

# --- OS & Editor ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Testing & Coverage ---
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
test-results/

# --- Deployment artifacts ---
*.zip
*.tar.gz
*.rar
deploy/
deployment_scripts/local/

# --- Node (if any frontend tooling) ---
node_modules/
npm-debug.log*
yarn-error.log*
.npm
.yarn/

# --- Jupyter (if any analysis notebooks) ---
.ipynb_checkpoints/
*.ipynb

# --- WhatsApp / Twilio / API specific ---
webhook_logs/
call_recordings/
media_uploads/
