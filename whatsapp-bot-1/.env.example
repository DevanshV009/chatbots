# ============================================================
#  .env.example — WhatsApp Bot #1
#  Copy this to .env and fill in actual values.
#  NEVER commit .env to git.
# ============================================================

# --- Meta / WhatsApp Business API ---
WHATSAPP_TOKEN=your_meta_access_token_here
VERIFY_TOKEN=your_custom_webhook_verify_token_here
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WABA_ID=your_whatsapp_business_account_id_here

# --- Flask ---
FLASK_ENV=development          # change to "production" on server
FLASK_DEBUG=1                  # set to 0 in production
SECRET_KEY=change_this_to_a_random_string

# --- Database ---
DATABASE_URL=sqlite:///leads.db     # dev: SQLite | prod: postgresql://user:pass@host/db

# --- Optional Integrations ---
# GOOGLE_SHEETS_CRED_FILE=service_account.json
# SHEET_ID=your_google_sheet_id_here

# --- Logging ---
LOG_LEVEL=DEBUG     # DEBUG | INFO | WARNING | ERROR
